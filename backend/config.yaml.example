# Muse 服务器配置文件

server:
  host: "0.0.0.0"
  port: 8080

auth:
  # JWT 加密密钥，生产环境请务必修改为随机字符串
  jwt_secret: "your-secret-key-change-in-production"

# API密钥加密配置
api_encrypt:
  # 加密密钥，生产环境请务必修改为强随机字符串
  # 如果启用加密，前端需要使用相同的密钥进行解密
  encryption_key: "your-encryption-key-change-in-production"
  # 是否允许前端获取API密钥（如果启用加密，返回的是密文）
  # 如果设置为false，前端将无法获取API密钥
  allow_get_key: true

# 静态文件服务配置
static_file:
  # 是否启用静态文件服务（集成部署模式）
  # 设置为false时为分离部署模式，需要单独部署前端
  enabled: true
  # 前端构建产物目录路径
  # 使用 compile.sh 编译时，前端资源会内嵌到二进制文件中，无需此配置
  # 仅在开发模式（go run）下才从磁盘读取前端文件
  frontend_dir: "./frontend/dist"

# 候选模型配置
# key为APIProvider枚举名（如OpenAI、Claude、Gemini），value为模型列表
candidate_models:
  OpenAI:
    - "gpt-4"
    - "gpt-4-turbo"
    - "gpt-3.5-turbo"
  Claude:
    - "claude-3-opus-20240229"
    - "claude-3-sonnet-20240229"
    - "claude-3-haiku-20240307"

database:
  # 数据库驱动: sqlite 或 mysql
  # sqlite: 生产环境推荐，无需额外安装数据库，数据存储在本地文件
  # mysql: 开发环境推荐，方便调试和查看数据
  driver: "sqlite"

  # SQLite 配置 (driver 为 sqlite 时使用)
  sqlite_path: "./data/muse.db"

  # MySQL 配置 (driver 为 mysql 时使用)
  host: "localhost"
  port: 3306
  username: "root"
  password: "your_password"
  database: "muse"
  charset: "utf8mb4"
  max_idle_conns: 10
  max_open_conns: 100
